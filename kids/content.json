  "lessons": [
    {"n": 1, "concept": "order", "icon": "fa-arrow-right",
     "cards": ["m:greeting", "m:dance1", "m:clapping1", "m:cheer1", "m:yes_h", "m:no_h", "s:hello", "s:name", "s:yay", "s:love", "s:bye", "c:red", "c:yellow", "c:green", "c:blue", "c:purple", "c:off"],
     "ko": "첫 재주", "en": "First trick",
     "goal_ko": "카드를 놓은 차례대로 로봇이 움직인다는 것을 안다. 만든 줄을 재주로 저장한다.",
     "goal_en": "Know that the robot follows the cards in order. Save a row as a trick.",
     "ask_ko": "카드 순서를 바꾸면 로봇은 어떻게 달라질까?",
     "ask_en": "What changes if you swap the order of the cards?"},
    {"n": 2, "concept": "order", "icon": "fa-music",
     "cards": ["a:do", "a:re", "a:mi", "a:fa", "a:sol", "a:ding", "a:boing", "a:drum", "w:1", "w:2"],
     "ko": "소리와 차례", "en": "Sounds in order",
     "goal_ko": "소리 카드로 노래를 만들고, 기다리기로 박자를 맞춘다.",
     "goal_en": "Make a song with sound cards and use waits for the beat.",
     "ask_ko": "같은 소리 카드로 다른 노래를 만들 수 있을까?",
     "ask_en": "Can you make a different song with the same sound cards?"},
    {"n": 3, "concept": "debug", "icon": "fa-wrench", "cards": [],
     "ko": "고치기 ①", "en": "Fix it 1",
     "goal_ko": "로봇이 한 일과 해야 할 일을 비교해 틀린 곳을 찾는다.",
     "goal_en": "Compare what the robot did with the goal to find the mistake.",
     "ask_ko": "어디서부터 달라졌을까?",
     "ask_en": "Where did it start to go wrong?"},
    {"n": 4, "concept": "debug", "icon": "fa-wrench", "cards": [],
     "ko": "고치기 ②", "en": "Fix it 2",
     "goal_ko": "필요 없는 카드를 빼고, 차례가 바뀐 카드를 바로잡는다.",
     "goal_en": "Take out extra cards and fix cards in the wrong order.",
     "ask_ko": "카드 하나만 바꿔서 고칠 수 있을까?",
     "ask_en": "Can you fix it by changing just one card?"},
    {"n": 5, "concept": "repeat", "icon": "fa-repeat", "cards": ["r:2", "r:3", "r:5"],
     "ko": "반복 ①", "en": "Repeat 1",
     "goal_ko": "같은 일을 여러 번 할 때 반복 카드 하나로 줄인다.",
     "goal_en": "Use one repeat card instead of the same card many times.",
     "ask_ko": "카드를 몇 장까지 줄일 수 있을까?",
     "ask_en": "How few cards can you use?"},
    {"n": 6, "concept": "repeat", "icon": "fa-repeat", "cards": [],
     "ko": "반복 ②", "en": "Repeat 2",
     "goal_ko": "반복 안에 여러 카드를 넣어 무늬(패턴)를 만든다.",
     "goal_en": "Put several cards in a repeat to make a pattern.",
     "ask_ko": "반복 안의 카드는 몇 번 실행될까?",
     "ask_en": "How many times do the cards inside the repeat run?"},
    {"n": 7, "concept": "reuse", "icon": "fa-puzzle-piece", "cards": ["tricks"],
     "ko": "내 재주 카드", "en": "My trick cards",
     "goal_ko": "저장한 재주가 카드 한 장이 되어 다른 줄에서 쓰인다는 것을 안다.",
     "goal_en": "Know that a saved trick becomes one card you can use in other rows.",
     "ask_ko": "재주 카드 한 장 안에는 카드가 몇 장 들어 있을까?",
     "ask_en": "How many cards are inside one trick card?"},
    {"n": 8, "concept": "reuse", "icon": "fa-cake-candles", "cards": [],
     "ko": "큰 재주 만들기", "en": "Build a big trick",
     "goal_ko": "작은 재주들을 모아 큰 재주를 만들고, 작은 재주를 고치면 큰 재주도 바뀐다는 것을 안다.",
     "goal_en": "Build a big trick from small tricks. Fixing a small trick changes the big one too.",
     "ask_ko": "작은 재주 하나를 고치면 큰 재주는 어떻게 될까?",
     "ask_en": "If you change a small trick, what happens to the big one?"}
  ],

  "challenges": [
    {"id": "1-1", "lesson": 1, "device": ["pibo"], "icon": "fa-hand", "on": "run",
